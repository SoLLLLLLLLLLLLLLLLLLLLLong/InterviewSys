# DeepSeek/SiliconFlow
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash

EMBEDDING_API_KEY=replace_me
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
WEATHER_API_KEY=replace_me

# Local development: leave ENABLE_PLATFORM_DB=false to keep SQLite + JSON fallback.
# Production-style development: start MySQL/Redis yourself, then enable these values.
ENABLE_PLATFORM_DB=false
DATABASE_URL=mysql+pymysql://NBN:NBN@127.0.0.1:3306/interview_coach?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
ENABLE_LANGGRAPH=true
SECURE_COOKIE=false
MAX_UPLOAD_MB=15
AGENT_EVENT_TTL_SECONDS=3600

# RBAC bootstrap. Once MySQL is enabled, roles can be changed in the admin UI.
ADMIN_EMAILS=admin@qq.com
INTERVIEWER_EMAILS=interviewer@qq.com

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=interview-coach-debug
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend optional: run Live2D-web separately and point the digital interviewer iframe to it.
# Example: VITE_LIVE2D_URL=http://127.0.0.1:5174/
VITE_LIVE2D_URL=
